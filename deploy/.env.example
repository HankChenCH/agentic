# =============================================================================
# agentic 全栈部署环境变量模板 —— cp .env.example .env 后按需修改
# compose 自动读取同目录 .env；仅本文件中列出的变量会注入容器
# =============================================================================

# ---- 必填 ----
# DeepSeek API Key（llm.yaml 无默认值，缺失则整栈拒绝启动）
DEEPSEEK_API_KEY=

# JWT 签名密钥（HS256，≥32 字节强随机串；缺失 compose 拒绝启动，prod 环境
# 应用还会二次校验：dev 兜底密钥/长度不足同样拒绝启动）。生成示例：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=

# ---- 可选（缺省值见 docker-compose.yaml 注释；下行为常用的几项）----

# 运行环境：prod（缺省，错误响应脱敏/日志 INFO）/ dev（排障时详细堆栈）
#APP_ENV=prod

# 前端对外端口 / 后端直连调试端口（8080 被 weaviate 占用，前端缺省 8081）
#WEB_PORT=8081
#SERVER_PORT=8000

# MinerU API Key（知识库 PDF 云端解析；留空则首次解析报错，不影响其余功能）
#MINERU_API_KEY=

# rustfs 预签名 URL 对外基地址：必须浏览器可达。默认 http://127.0.0.1:9000
# （本机访问）；远程部署改为 http://<部署机地址>:9000
#RUSTFS_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# 宿主机 Ollama 地址（记忆沉淀/知识库检索的 embedding 模型 bge-m3）
# 需先在宿主机：ollama pull bge-m3
#OLLAMA_API_URL=http://host.docker.internal:11434

# ---- 可选：自建 ESM CDN（esm.sh 官方镜像 + 阿里云 npmmirror 包源）----
# react 全家的前端产物默认从 esm.sh 官方公网源加载；内网/国内加速可切换为
# 自建服务。两步启用：
#   1) docker compose --profile esm-sh up -d esm-sh
#   2) 取消下行注释并填「浏览器可达」地址（远程部署用部署机 IP/域名，
#      勿用 127.0.0.1），然后重建前端：docker compose build frontend
#      && docker compose up -d frontend
#FRONTEND_CDN_BASE=http://127.0.0.1:8082
# 自建 esm.sh 的上游 npm registry（缺省即阿里云 npmmirror）
#ESM_SH_NPM_REGISTRY=https://registry.npmmirror.com/
# 自建 esm.sh 对外端口（浏览器直达，缺省 8082；8080=weaviate 8081=前端）
#ESM_SH_PORT=8082

# 中间件凭据（与 server/docker-compose.yaml 同一组变量，两端保持一致）
#POSTGRES_USER=agentic
#POSTGRES_PASSWORD=agentic
#POSTGRES_DB=agentic
#RUSTFS_ACCESS_KEY=agentic
#RUSTFS_SECRET_KEY=agentic-secret
#RUSTFS_BUCKET=agentic
