# agentic 后端环境变量示例 —— 复制为 .env 后按需修改
#
# 取值优先级：进程环境变量 > .env > YAML 内联默认值（加载逻辑见 app/core/config/loader.py）。
# 除 DEEPSEEK_API_KEY 外，所有变量在 app/configs/*.yaml 中都有内联默认值，留空即可用默认；
# 注释掉的行 = 默认值，取消注释即覆盖。
# 本文件同样被 docker compose 读取：POSTGRES_* 与 RUSTFS_* 的凭据值会同步作用于中间件栈。

# ── 应用（app.yaml）────────────────────────────────────────────
# 应用名
#APP_NAME=agentic-app
# 运行环境 dev/test/prod：决定异常响应详略（dev/test 附 detail+trace，prod 只回通用信息）与日志默认级别
#APP_ENV=dev

# ── LLM（llm.yaml）────────────────────────────────────────────
# DeepSeek API Key（唯一无默认值的必填变量；deepseek-flash / deepseek-pro 共用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容网关：llm.yaml 的 openai-chat / openai-embedding entry 默认注释，
# 启用后才需要以下两项（api_url 填网关地址，model 按网关支持调整，见 llm.yaml）
#OPENAI_API_URL=
#OPENAI_API_KEY=

# ── 文档解析（document_parser.yaml）───────────────────────────
# MinerU 云端 PDF 解析 Bearer token（mineru.net 控制台申请）；留空时知识库文档首次解析 fail-fast
#MINERU_API_KEY=

# ── 认证（auth.yaml）──────────────────────────────────────────
# JWT 签名密钥：HS256 建议 ≥32 字节（过短 PyJWT 告警）；生产环境必须显式设置
#AUTH_JWT_SECRET=dev-only-secret-0123456789abcdef-change-me

# ── 数据库（db.yaml）──────────────────────────────────────────
# SQLite 文件路径（db.yaml default=sqlite 时生效）
#DB_DSN=data/agentic.db
# PostgreSQL（db.yaml default 切为 postgres 时生效；凭据亦被 docker compose 读取）
#POSTGRES_HOST=127.0.0.1
#POSTGRES_PORT=5432
#POSTGRES_USER=agentic
#POSTGRES_PASSWORD=agentic
#POSTGRES_DB=agentic

# ── Redis（redis.yaml：Celery broker/backend 与取消信号存储共用）─
#REDIS_URL=redis://127.0.0.1:6379/0

# ── 向量库（vector_db.yaml）───────────────────────────────────
#WEAVIATE_HOST=127.0.0.1
#WEAVIATE_PORT=8080
# gRPC 宿主端口：YAML 内联默认 50051，但 compose 把宿主侧映射到 50052
#（50051 常被本机 Ollama 桌面版占用会截走 gRPC 流量），本地开发保持 50052
#WEAVIATE_GRPC_PORT=50052

# ── 对象存储（filesystem.yaml：rustfs entry；凭据亦被 docker compose 读取）─
#RUSTFS_ENDPOINT=http://127.0.0.1:9000
#RUSTFS_ACCESS_KEY=agentic
#RUSTFS_SECRET_KEY=agentic-secret
#RUSTFS_BUCKET=agentic

# ── HTTP 边缘策略（http.yaml）─────────────────────────────────
# CORS 源白名单：逗号分隔整体覆盖；精确 scheme+host[:port]，无尾斜杠，不允许 *
#CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#CORS_ALLOW_CREDENTIALS=true
# run / 上传端点限流（按客户端 IP 滑动窗口：窗口内次数 / 窗口秒数）
#RUN_RATE_LIMIT=30
#RUN_RATE_WINDOW_SECONDS=60
#UPLOAD_RATE_LIMIT=10
#UPLOAD_RATE_WINDOW_SECONDS=60
# run / 上传请求体字节上限（run 1 MiB / upload 64 MiB，含 multipart 表单开销）
#RUN_MAX_BODY_BYTES=1048576
#UPLOAD_MAX_BODY_BYTES=67108864

# ── 日志（logging.yaml）───────────────────────────────────────
# 全局日志级别；留空按环境推导（dev/test=DEBUG，prod=INFO）
#AGENTIC_LOG_LEVEL=
# 文件 sink 的日志目录
#AGENTIC_LOG_DIR=runtime/logs

# ── 启动参数（代码读取，非 YAML 插值）─────────────────────────
# 配置目录 / .env 路径整体覆盖；CLI 等价：python -m app.cmd.http --config-dir / --env-file
#AGENTIC_CONFIG_DIR=
#AGENTIC_ENV_FILE=
